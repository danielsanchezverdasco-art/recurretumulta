<style id="wp-custom-css">
/* contacts */

.contacts-container a {
color: black !important; 
}

.contacts-container a:hover { 
color: var(--bili-primary-color) !important;
}

/* footer and 404 */
.footer-links-container a {
	color: white !Important; 
}

.footer-links-container a:hover, 
.elementor-element-c8deee6 a:hover { 
color: var(--bili-primary-color) !important;
}

.page_404_wrapper .wgl-button:after {
	background-color: var(--bili-primary-color) !important;
}

/* single item page */
.bottomPart::after { 

    display: block;
    content: "";
    width: 100%;
    height: 200px;
    position: absolute;
    background: #e6e6e6;
    left: 0;
    bottom: 0;
}

@media(max-width: 1024px) {
	.bottomPart::after {
		height: 100px; 
	}
	.wgl-theme-header {
		background: white; 
	}
}

.primary-nav > ul > li > a > span .menu-item_dots {
	display: none; 
}

/* single item in a listing*/
.single-item-container:hover img {
	    transform: translateY(-10px);
	  transition: .4s;
}

.single-item-container img {
	   transition: .4s;
}

.single-item-container:hover a {
	color: var(--bili-primary-color) !important;
	  transition: all .2s ease-out;
}

.single-item-container a {

	  transition: all .2s ease-out;
}

/*  */

.wgl-mobile-header .wgl-header-row_wrapper {
	height: 100px !important; 
}

.hamburger-box .hamburger-inner span, 
.wgl-mobile-header .header_search-button, .wgl-mobile-header .header_search-close {
	color: black; 
}

.menu-item_dots {
	display: none !important; 
}

#main { 
padding: 0 !important; 
}
</style>
