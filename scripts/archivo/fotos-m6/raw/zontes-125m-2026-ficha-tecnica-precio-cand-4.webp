<style id="avolo-core-css-inline-css">.avolo-filter-wrapper{position:sticky;top:0;z-index:999;background:#fff;box-shadow:0 4px 15px rgb(0 0 0 / .05)}.avolo-main-filter{display:flex;align-items:center;justify-content:center;gap:20px;flex-wrap:wrap;padding:15px 20px}.f-item{padding-bottom:5px;min-width:150px}.f-item select{border:none;font-weight:800;font-size:15px;background:#fff0;cursor:pointer;outline:none;width:100%;color:#333}.avolo-advanced-filters{display:none;background:#fdfdfd;border-top:1px solid #eee;padding:20px;box-shadow:inset 0 -4px 10px rgb(0 0 0 / .02)}.avolo-advanced-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:20px;max-width:1200px;margin:0 auto}.btn-toggle-advanced{background:#fff0;border:1px solid #C22E5F;color:#C22E5F;padding:10px 20px;border-radius:50px;font-weight:800;cursor:pointer;transition:0.3s}.btn-toggle-advanced:hover{background:#C22E5F;color:#fff}.btn-search{background:#C22E5F;color:#fff;border:none;padding:12px 35px;border-radius:50px;font-weight:800;cursor:pointer;text-transform:uppercase;transition:0.3s}.btn-search:hover{opacity:.9;transform:scale(1.02)}@media (max-width:768px){.avolo-main-filter{gap:15px;justify-content:flex-start;overflow-x:auto;flex-wrap:nowrap;padding-bottom:15px;-webkit-overflow-scrolling:touch}.f-item{flex-shrink:0;min-width:130px}.btn-toggle-advanced,.btn-search{flex-shrink:0}}.avolo-badge-combo{display:inline-flex;align-items:center;height:45px;gap:8px}.pill-combustible{color:#fff;font-size:10px;font-weight:800;padding:0 12px;height:28px;display:flex;align-items:center;border-radius:20px;white-space:nowrap;text-transform:uppercase;letter-spacing:.5px}.pill-hibrido{background-color:#949ed6}.pill-hibrido-enchufable{background-color:#00ced1}.pill-electrico{background-color:#2980b9}.pill-gasolina{background-color:#27ae60}.pill-diesel{background-color:#f39c12}.pill-default{background-color:#34495e}.energy-label-icon{height:45px;width:45px;object-fit:contain}.avolo-contact{display:inline-flex;align-items:center;gap:6px}.avolo-contact-reveal{display:inline-flex;align-items:center;gap:6px;cursor:pointer;border:1px solid var(--avolo-contact-border,#2563eb);background:var(--avolo-contact-bg,transparent);color:var(--avolo-contact-text,#2563eb);font:inherit;font-size:.95em;line-height:1.3;padding:5px 12px;border-radius:8px;transition:all .15s}.avolo-contact-reveal:hover{background:var(--avolo-contact-bg-hover,#2563eb);border-color:var(--avolo-contact-bg-hover,#2563eb);color:var(--avolo-contact-text-hover,#fff)}.avolo-contact-reveal[disabled]{opacity:.6;cursor:wait}.avolo-contact-value{display:inline-flex;align-items:center;gap:6px;font:inherit}.avolo-contact-value a{color:var(--avolo-contact-link,#2563eb);text-decoration:none;font-weight:600}.avolo-contact-value a:hover{text-decoration:underline}.avolo-contact-hp{position:absolute!important;left:-9999px!important;width:1px;height:1px;overflow:hidden;opacity:0;pointer-events:auto}.avolo-contact-error{color:#b91c1c;font-size:.9em}.avolo-desc-container{position:relative;font-size:14px;line-height:1.6;margin-bottom:20px}.avolo-desc-content{max-height:120px;overflow:hidden;position:relative;transition:max-height 0.4s ease-out}.avolo-desc-content h2,.avolo-desc-content h3{text-transform:lowercase}.avolo-desc-content h2::first-letter,.avolo-desc-content h3::first-letter{text-transform:uppercase}.avolo-desc-content.expanded{max-height:2000px}.avolo-desc-fade{position:absolute;bottom:0;left:0;width:100%;height:60px;background:linear-gradient(to bottom,#fff0,rgb(255 255 255));pointer-events:none;transition:opacity 0.3s}.avolo-desc-content.expanded .avolo-desc-fade{opacity:0}.avolo-desc-toggle{display:inline-block;margin-top:10px;font-weight:600;cursor:pointer;font-size:14px;color:#55B6E8;border-bottom:1px dashed #55B6E8}.avolo-desc-toggle:hover{color:#1E88E5;border-bottom-color:#1E88E5}.avolo-gallery-container{display:flex;gap:15px;height:550px;width:100%;padding:10px;background:#1F2F4D;border-radius:12px;box-sizing:border-box;user-select:none;-webkit-user-select:none}.avolo-thumbs{width:110px;height:100%;flex-shrink:0}.avolo-thumbs .swiper-slide{height:80px!important;border-radius:6px;overflow:hidden;opacity:.4;cursor:pointer;border:2px solid #fff0;transition:0.3s}.avolo-thumbs .swiper-slide-thumb-active,.avolo-thumbs .swiper-slide:hover{opacity:1;border-color:#C22E5F}.avolo-thumbs img{width:100%;height:100%;object-fit:cover}.avolo-main-gallery{flex-grow:1;height:100%;background:#1F2F4D;border-radius:8px;overflow:hidden;cursor:zoom-in;position:relative}.avolo-main-gallery .swiper-slide{display:flex;align-items:center;justify-content:center}.avolo-main-gallery img{max-width:100%;max-height:100%;object-fit:contain}.avolo-main-gallery .swiper-button-next,.avolo-main-gallery .swiper-button-prev{color:#fff;background:rgb(0 0 0 / .4);width:44px;height:44px;border-radius:50%;backdrop-filter:blur(4px);transition:background 0.3s}.avolo-main-gallery .swiper-button-next:hover,.avolo-main-gallery .swiper-button-prev:hover{background:rgb(194 46 95 / .8)}.avolo-main-gallery .swiper-button-next:after,.avolo-main-gallery .swiper-button-prev:after{font-size:18px;font-weight:700}@media (max-width:768px){.avolo-gallery-container{flex-direction:column-reverse;height:auto;min-height:450px;padding:5px}.avolo-main-gallery{height:350px;width:100%}.avolo-thumbs{width:100%;height:80px;margin-top:10px}.avolo-thumbs .swiper-slide{width:90px!important}.avolo-main-gallery .swiper-button-next,.avolo-main-gallery .swiper-button-prev{width:36px;height:36px}.avolo-main-gallery .swiper-button-next:after,.avolo-main-gallery .swiper-button-prev:after{font-size:14px}}.avolo-product-badge{display:inline-flex;align-items:center;justify-content:center;padding:6px 14px;font-family:'Arimo',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;border-radius:30px;box-shadow:0 4px 15px rgb(0 0 0 / .08);transition:all 0.4s cubic-bezier(.165,.84,.44,1);position:relative;overflow:hidden;white-space:nowrap;border:1px solid rgb(255 255 255 / .15);text-shadow:0 1px 2px rgb(0 0 0 / .15);user-select:none;z-index:10}.coche-specs-universal{font-size:14px;color:#666;padding:10px 0}</style>
<style id="avolo-autocomplete-css-inline-css">.avolo-search-text-container{position:relative;width:100%;max-width:600px;margin:0 auto;box-sizing:border-box}.avolo-search-text-input-wrap{display:flex;align-items:center;background:#fff;border:2px solid #e2e8f0;border-radius:50px;padding:4px 6px 4px 20px;transition:all 0.3s ease;box-shadow:0 4px 6px -1px rgb(0 0 0 / .05)}.avolo-search-text-input-wrap:focus-within{border-color:var(--avolo-primary,#C22E5F);box-shadow:0 10px 15px -3px rgb(0 0 0 / .1)}.avolo-search-text-input{flex:1;border:none;background:#fff0;outline:none;font-size:15px;color:#1a202c;padding:8px 0;font-family:inherit}.avolo-search-text-input::placeholder{color:#a0aec0}.avolo-search-text-btn{background:var(--avolo-primary,#C22E5F);border:none;outline:none;color:#fff;width:38px;height:38px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background 0.2s ease,transform 0.1s ease;flex-shrink:0}.avolo-search-text-btn:hover{background:var(--avolo-primary-hover,#a11f49);transform:scale(1.05)}.avolo-search-text-btn:active{transform:scale(.95)}.avolo-search-text-dropdown{position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #e2e8f0;border-radius:14px;margin-top:8px;box-shadow:0 15px 30px rgb(0 0 0 / .08);z-index:9999;max-height:350px;overflow-y:auto;display:flex;flex-direction:column;padding:6px 0}.avolo-autocomplete-item{display:flex;align-items:center;padding:10px 16px;text-decoration:none;color:inherit;transition:background 0.2s ease;border-bottom:1px solid #f7fafc}.avolo-autocomplete-item:last-child{border-bottom:none}.avolo-autocomplete-item:hover,.avolo-autocomplete-item.focused{background:#f7fafc;outline:none;text-decoration:none}.avolo-autocomplete-img{width:50px;height:35px;object-fit:cover;border-radius:6px;margin-right:12px;flex-shrink:0;background:#edf2f7}.avolo-autocomplete-info{flex:1;display:flex;flex-direction:column;min-width:0}.avolo-autocomplete-title{font-size:13.5px;font-weight:700;color:#2d3748;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0 0 2px 0}.avolo-autocomplete-specs{font-size:11px;color:#718096;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0}.avolo-autocomplete-price{font-size:13.5px;font-weight:800;color:var(--avolo-primary,#C22E5F);margin-left:12px;flex-shrink:0}.avolo-autocomplete-no-results{padding:16px;text-align:center;color:#718096;font-size:13.5px}</style>
