    "i18next": "^26.4.2",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "motion": "^12.43.0",
    "next-themes": "^0.4.6",
    "openai": "^7.8.0",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.13",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "resend": "^6.30.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "use-debounce": "^10.1.1",
    "vaul": "^1.1.2"
