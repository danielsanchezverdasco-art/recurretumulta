{
  "name": "app-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "validar:geo": "node scripts/geo/validar.mjs /tmp/fichas-problematicas-geo.csv",
    "build": "node scripts/check-convex-url.mjs && node scripts/copy-media.mjs && node scripts/gen-fichas-redirigidas.mjs && node scripts/gen-blog-lite.mjs && python3 scripts/gen-cards.py && node scripts/gen-data-loaders.mjs && node scripts/gen-ficha-extra.mjs && node scripts/gen-fechas-eeat.mjs && node scripts/historial-precios/gen.mjs && node scripts/audiencia/gen.mjs && tsc -b && vite build",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "prettier-fix": "prettier --write .",
    "prettier-check": "prettier --check .",
    "build:full": "node scripts/gen-sitemap.mjs && npm run build && node scripts/prerender.mjs && node scripts/apply-seo.mjs dist && python3 scripts/postfix-dist.py dist && python3 scripts/postfix-vacios.py dist && python3 scripts/fix-redirects.py && python3 scripts/postfix-r24.py dist && python3 scripts/sitemap-final.py dist && python3 scripts/postfix-r24.py dist --solo-sitemap",
    "serve:dist": "npx -y serve dist -l 8088 -n -s",
    "parity": "node ../shots.mjs http://localhost:8088 local && python3 ../diff.py ../shots/base ../shots/local"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
